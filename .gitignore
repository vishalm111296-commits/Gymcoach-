# Default ignored files
/.gradle/
/build/
/app/build/
!gradle/wrapper/gradle-wrapper.jar

# IDE files
.idea/
*.iml
.cxx/
local.properties

# OS files
.DS_Store
Thumbs.db

# Secrets - NEVER commit these
*.jks
*.keystore
secrets.properties
keystore/

# Build artifacts
/app/release/
*.apk
*.aab

# Local build/debug logs
build_output.txt
build_output_clean.txt
