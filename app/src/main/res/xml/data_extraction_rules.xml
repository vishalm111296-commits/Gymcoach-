<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gymcoach_database" />
        <exclude domain="database" path="gymcoach_database-wal" />
        <exclude domain="database" path="gymcoach_database-shm" />
        <exclude domain="sharedpref" path="gymcoach_seed.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gymcoach_database" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
